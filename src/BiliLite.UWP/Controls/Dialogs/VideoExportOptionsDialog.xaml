<ContentDialog
    x:Class="BiliLite.Controls.Dialogs.VideoExportOptionsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:BiliLite.Controls.Dialogs"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="导出视频"
    Background="{ThemeResource SystemControlAcrylicElementBrush}"
    CloseButtonStyle="{StaticResource DefaultButtonStyle}"
    CloseButtonText="取消"
    CornerRadius="{ThemeResource OverlayCornerRadius}"
    DefaultButton="Primary"
    PrimaryButtonStyle="{StaticResource AccentButtonStyle}"
    PrimaryButtonText="选择保存位置"
    mc:Ignorable="d">

    <ScrollViewer MaxHeight="520">
        <StackPanel MinWidth="380" Spacing="6">
            <TextBlock FontWeight="SemiBold" Text="导出格式" />
            <RadioButton
                Checked="Mp4_Checked"
                Content="MP4"
                GroupName="format"
                IsChecked="{x:Bind ViewModel.IsMp4, Mode=OneWay}" />
            <RadioButton
                Checked="Mkv_Checked"
                Content="MKV"
                GroupName="format"
                IsChecked="{x:Bind ViewModel.IsMkv, Mode=OneWay}" />

            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.Mp4PanelVisibility, Mode=OneWay}">
                <TextBlock
                    Margin="0,8,0,0"
                    FontWeight="SemiBold"
                    Text="编码方式" />
                <RadioButton
                    Checked="CopyMode_Checked"
                    Content="直接封装"
                    GroupName="mode"
                    IsChecked="{x:Bind ViewModel.IsCopyMode, Mode=OneWay}" />
                <RadioButton
                    Checked="TranscodeMode_Checked"
                    Content="转码为 H.264 + AAC"
                    GroupName="mode"
                    IsChecked="{x:Bind ViewModel.IsTranscodeMode, Mode=OneWay}" />

                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.TranscodePanelVisibility, Mode=OneWay}">
                    <CheckBox IsChecked="{x:Bind ViewModel.HdrToSdr, Mode=TwoWay}">HDR 转 SDR</CheckBox>
                    <TextBlock
                        Margin="28,-6,0,0"
                        Text="源视频是 HDR 或杜比视界时才需要勾选"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="分辨率" />
                        <ComboBox
                            MinWidth="150"
                            DisplayMemberPath="Key"
                            ItemsSource="{x:Bind ViewModel.DownscaleOptions, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedDownscale, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Margin="0,8,0,0"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.VideoTrackPanelVisibility, Mode=OneWay}">
                    <TextBlock FontWeight="SemiBold" Text="视频轨" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.VideoTracks, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedVideoTrack, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel
                    Margin="0,4,0,0"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.AudioTrackPanelVisibility, Mode=OneWay}">
                    <TextBlock FontWeight="SemiBold" Text="音频轨" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Label"
                        ItemsSource="{x:Bind ViewModel.AudioTracks, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedAudioTrack, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel
                    Margin="0,4,0,0"
                    Spacing="4"
                    Visibility="{x:Bind ViewModel.SubtitlePanelVisibility, Mode=OneWay}">
                    <TextBlock FontWeight="SemiBold" Text="字幕轨" />
                    <ComboBox
                        HorizontalAlignment="Stretch"
                        DisplayMemberPath="Name"
                        ItemsSource="{x:Bind ViewModel.SubtitleOptions, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedSubtitle, Mode=TwoWay}" />
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
