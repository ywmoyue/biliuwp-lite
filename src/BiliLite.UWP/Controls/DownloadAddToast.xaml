<UserControl
    x:Class="BiliLite.Controls.DownloadAddToast"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModel="using:BiliLite.ViewModels.Download"
    d:DesignHeight="300"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid x:Name="mainGrid">
        <Border
            x:Name="rootBorder"
            Width="360"
            MaxHeight="380"
            Margin="0,0,24,24"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Background="{ThemeResource SystemControlAcrylicElementBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="{ThemeResource OverlayCornerRadius}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <Grid Padding="12,10,6,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <FontIcon
                            Margin="0,0,8,0"
                            FontSize="14"
                            Glyph="&#xE896;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="添加下载" />
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="CloseButton_OnClick"
                        ToolTipService.ToolTip="关闭">
                        <FontIcon FontSize="10" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    MaxHeight="320"
                    Padding="12,0,12,12"
                    VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{x:Bind Batches}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="viewModel:DownloadAddBatchViewModel">
                                <StackPanel Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Text="{x:Bind Path=Title}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTipService.ToolTip="{x:Bind Path=Title}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            FontSize="12"
                                            Foreground="Gray"
                                            Text="{x:Bind Path=StatusText, Mode=OneWay}" />
                                    </Grid>

                                    <ItemsControl Margin="0,4,0,0" ItemsSource="{x:Bind Path=Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="viewModel:DownloadEpisodeItemViewModel">
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        Margin="0,0,8,0"
                                                        FontSize="12"
                                                        Text="{x:Bind Path=Title}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{x:Bind Path=Title}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        FontSize="12"
                                                        Foreground="Gray"
                                                        Text="{x:Bind Path=StateText, Mode=OneWay}"
                                                        Visibility="{x:Bind Path=IsStateError, Mode=OneWay, Converter={StaticResource DisplayConvert}}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        MaxWidth="220"
                                                        FontSize="12"
                                                        Foreground="#FFE81123"
                                                        Text="{x:Bind Path=StateText, Mode=OneWay}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTipService.ToolTip="{x:Bind Path=StateText, Mode=OneWay}"
                                                        Visibility="{x:Bind Path=State, Mode=OneWay, Converter={StaticResource DisplayConvert}, ConverterParameter=99}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
